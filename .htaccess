# Only used when the domain points at this folder (e.g. OVH "www/") instead of public/.
# Forwards every request into public/, so URLs stay /images/..., /contact, etc.
# and nothing outside public/ (src, templates, vendor, config...) is reachable.
# If the domain points directly at public/, this file is outside the web root and ignored.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite, refuse everything rather than expose the project files
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
